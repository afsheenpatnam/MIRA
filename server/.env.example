PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string, or mongodb://127.0.0.1:27017/mira for local
MONGODB_URI=
# Any long random string
JWT_SECRET=

# Hindsight Cloud: copy the API URL and key from https://ui.hindsight.vectorize.io
# (self-hosted: http://localhost:8888 and no key)
HINDSIGHT_URL=
HINDSIGHT_API_KEY=
BANK_PREFIX=mira-

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Seals the audit ledger (any long random string). Set it once and never change it,
# or blocks written before the change will fail verification.
AUDIT_SECRET=
